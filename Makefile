####### Compile

main.o: src/main.cpp include/mainwindow.h \
		include/clientapi.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o src/main.cpp

dishserver.o: src/dishserver.cpp include/dishserver.h \
		include/functionstoserver.h \
		include/db_singleton.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o dishserver.o src/dishserver.cpp

storage.o: src/storage.cpp include/storage.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o storage.o src/storage.cpp

filters.o: src/filters.cpp include/filters.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o filters.o src/filters.cpp

db_singleton.o: src/db_singleton.cpp include/db_singleton.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o db_singleton.o src/db_singleton.cpp

functionstoserver.o: src/functionstoserver.cpp include/functionstoserver.h \
		include/usermanager.h \
		include/dishmanager.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o functionstoserver.o src/functionstoserver.cpp

usermanager.o: src/usermanager.cpp include/usermanager.h \
		include/db_singleton.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o usermanager.o src/usermanager.cpp

dishmanager.o: src/dishmanager.cpp include/dishmanager.h \
		include/db_singleton.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o dishmanager.o src/dishmanager.cpp

clientapi.o: src/clientapi.cpp include/clientapi.h \
		include/db_singleton.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o clientapi.o src/clientapi.cpp

clientsessionmanager.o: src/clientsessionmanager.cpp include/clientsessionmanager.h \
		include/db_singleton.h \
		include/models.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o clientsessionmanager.o src/clientsessionmanager.cpp

mainwindow.o: src/mainwindow.cpp include/mainwindow.h \
		ui_mainwindow.h \
		include/clientsessionmanager.h \
		include/db_singleton.h \
		include/models.h \
		include/clientapi.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o src/mainwindow.cpp

ingredientsscreen.o: src/ingredientsscreen.cpp include/ingredientsscreen.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o ingredientsscreen.o src/ingredientsscreen.cpp

moc_dishserver.o: moc_dishserver.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_dishserver.o moc_dishserver.cpp

moc_clientapi.o: moc_clientapi.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_clientapi.o moc_clientapi.cpp

moc_clientsessionmanager.o: moc_clientsessionmanager.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_clientsessionmanager.o moc_clientsessionmanager.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_ingredientsscreen.o: moc_ingredientsscreen.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_ingredientsscreen.o moc_ingredientsscreen.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/HappyMeals/bin || mkdir -p $(INSTALL_ROOT)/opt/HappyMeals/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/HappyMeals/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/HappyMeals/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/HappyMeals/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

